{
  "name": "molecular-workspace-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev -H 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:events": "node --test tests/*.test.cjs",
    "test:offscreen": "node tests/offscreen/driver.cjs",
    "test:offscreen:keyboard": "node tests/offscreen/history-keyboard.cjs",
    "test:offscreen:normal": "node tests/offscreen/normal-flow.cjs",
    "test:offscreen:scenes": "node tests/offscreen/scenes-flow.cjs",
    "test:offscreen:openmm": "node tests/offscreen/openmm-flow.cjs",
    "test:offscreen:retry": "node tests/offscreen/openmm-retry.cjs",
    "test:offscreen:faults": "node tests/offscreen/openmm-faults.cjs",
    "test:offscreen:post-races": "node tests/offscreen/openmm-post-races.cjs",
    "test:offscreen:dry-run": "node tests/offscreen/dry-run.cjs",
    "test:offscreen:persistence": "node tests/offscreen/openmm-persistence.cjs",
    "tokens": "python3 ../design/build_tokens.py"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "molstar": "5.11.0",
    "next": "15.5.26",
    "react": "19.1.9",
    "react-dom": "19.1.9"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "44.4.5",
    "playwright": "1.63.0",
    "typescript": "^5.6"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.4"
  }
}

  "knownLimitation": {
    "case": "two Host headers on :3000, allowed value first and foreign value second",
    "observed": "HTTP 200 on /api/capabilities (proxied, backend answered 200) and on /",
    "status": "observed pass-through — accepted known limitation per user decision 2026-09-28; browsers send a single Host so DNS rebinding remains blocked",
    "cause": "Node's HTTP server keeps only the first duplicate Host header in req.headers.host, and frontend/middleware.ts checks request.headers.get('host'). Reversed order (foreign first) is rejected by the middleware; :8000 rejects every duplicate-Host request at the uvicorn protocol layer.",
    "decision": "User decision 2026-09-28 (relayed by the orchestrator): record as a known limitation; no code change, no re-freeze."
  },
  "curlNote": "curl 7.87.0 with -H 'Host: a' -H 'Host: b' sends only the first Host header (verified with -v), so host-and-smoke/host-check-curl.txt is not a duplicate-header test; the raw-socket results above are authoritative.",
  "missingHostLayerDiagnostic": "host-and-smoke/host-diag-headers.txt: a later frontend-only restart of the same build showed full response headers — missing Host → 400 with no content-type/Vary (Node), foreign Host → 400 text/plain from the middleware.",

{
  "description": "프로젝트 공통 hook. .claude/settings.json 훅의 Codex 대응",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_tool_use.py\"",
            "timeout": 10,
            "statusMessage": "위험 명령 검사"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/stop.py\"",
            "timeout": 600,
            "statusMessage": "ruff + pytest"
          }
        ]
      }
    ]
  }
}
